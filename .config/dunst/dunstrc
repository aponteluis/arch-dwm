[global]
    font = JetBrainsMono Nerd Font 8
    origin = top-right
    offset = (12, 28)
    width = 300
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#444444"
    separator_color = frame
    background = "#111111"
    foreground = "#d0d0d0"

[urgency_critical]
    frame_color = "#e8a2a2"
    timeout = 0
